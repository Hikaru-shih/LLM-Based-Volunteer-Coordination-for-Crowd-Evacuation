    {"id":"higher_help_cost", "nearbyAgentCount":2, "exitNonBlockage":0.5, "volunteerCost":0.1, "failureCost":0.5, "unwillingness":5},
    {"id":"unblocked_negative_control", "nearbyAgentCount":2, "exitNonBlockage":1, "volunteerCost":0.005, "failureCost":0.5, "unwillingness":5}
