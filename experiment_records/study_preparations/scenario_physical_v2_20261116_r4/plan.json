  "apiCallsAllowed": 0,
  "randomization": "Fixed six fresh development seed blocks; paired initial positions, divergent trajectories need not share future random draws",
  "intervention": "Override decision callback; focal ID0 or all willing, others decline. No false Original or LLM policy claims.",
  "factors": "B2/B5 layouts and workProgress intervals1/4; total5 obstacles; no pure tau causal claim",
  "units": "simulation ticks, not measured human seconds",
  "failureRule": "Stop on invalid or unexpected API; retain all timeouts, negative benefits and unsuccessful handling; no automatic rerun",
  "mappingRule": {
    "scale": 301,
    "burden": "per-agent approach-assigned ticks plus active-handler ticks; includes nonworker candidates and failed approach",
    "personalDelta": "capped exit step in intervention minus same-ID None control",
    "othersBenefit": "mean capped exit step in None minus intervention for IDs1..9, focal comparison only",
    "noHelpLoss": "mean capped exit step None blocked minus None open; never use test-future values as LLM observation",
    "projection": "exploratory nonnegative time-burden/301 and nonnegative noHelpLoss/301; report zero/negative raw values and reject cv>=av or av=0, never clip into paper domain"
